# Copy to docs/boton/hosts.env (gitignored) and fill in.
# The IP is whatever the current Boton instance was provisioned with; it changes
# every time a box is recreated, which is why it is not committed.

BOTON_HOST=1.2.3.4
BOTON_USER=ubuntu
BOTON_KEY=$HOME/.ssh/rskj-automation

# Remote checkout location for the simulation repo.
BOTON_WORKDIR=/home/ubuntu/rsk-simulation

# Optional: a second box, referenced as `boton-ssh.sh --host "$BOTON_HOST_2"`.
# BOTON_HOST_2=

# Box identities used by run-experiment.sh / collect-experiment.sh.
# Box A is the reference; box B is the one that gets replaced.
BOTON_HOST_A=5.161.112.81
BOTON_HOST_B=91.107.194.5
